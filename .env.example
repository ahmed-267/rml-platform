APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Docker Postgres/Redis: docker compose up -d
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rml_platform
DB_USERNAME=rml_user
DB_PASSWORD=rml_password
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments (Phase 8)
# default_provider: manual_bank_transfer | mollie | stripe
# card_provider: stripe (recommended) | mollie
PAYMENT_DEFAULT_PROVIDER=manual_bank_transfer
PAYMENT_CARD_PROVIDER=stripe
PAYMENT_CURRENCY=EUR

# Stripe Checkout (card payments). Never commit real keys.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Google Maps (server-side geocoding). Never commit real keys.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_COUNTRY=ES
GOOGLE_MAPS_DEFAULT_CENTER_LAT=40.4168
GOOGLE_MAPS_DEFAULT_CENTER_LNG=-3.7038
GOOGLE_MAPS_DEFAULT_RADIUS_KM=50

# Spanish Catastro (national public HTTPS XML API — no secret key required)
CATASTRO_ENABLED=true
RML_CATASTRO_ENABLED=true
CATASTRO_PROVIDER_MODE=live
CATASTRO_BASE_URL=https://ovc.catastro.meh.es/OVCServWeb/OVCWcfCallejero/COVCCallejero.svc
CATASTRO_LEGACY_URL=https://ovc.catastro.meh.es/ovcservweb/ovcswlocalizacionrc/ovccallejero.asmx
CATASTRO_TIMEOUT=10
# Verified public OVC example refs (override locally after re-checking Consulta_DNPRC)
CATASTRO_DEMO_MATCH_REFERENCE=2749704YJ0624N0001DI
CATASTRO_DEMO_AREA_REVIEW_REFERENCE=2749704YJ0624N0001DI
CATASTRO_DEMO_SOLD_REFERENCE=2749704YJ0624N0001DI
RML_CATASTRO_AREA_TOLERANCE_PERCENT=15
RML_CATASTRO_COORDINATE_WARN_METERS=150
RML_CATASTRO_REQUIRE_FOR_AUDIT=false

# Browser Maps JS (Vite). Keep separate from the server geocoding key when possible.
VITE_GOOGLE_MAPS_API_KEY=

# Mollie (optional legacy card provider). Leave empty when using Stripe.
# Mollie webhooks cannot reach 127.0.0.1 — use ngrok if testing Mollie locally.
MOLLIE_KEY=
MOLLIE_WEBHOOK_SECRET=
MOLLIE_WEBHOOK_URL=

BANK_TRANSFER_ACCOUNT_NAME="RML Energy Saving"
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BIC=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_INSTRUCTIONS="Pay by bank transfer using the payment reference shown. Lead details are released after payment confirmation."

# WhatsApp Cloud API
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=34

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
